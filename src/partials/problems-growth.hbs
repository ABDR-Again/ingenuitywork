<!-- ===================== PROBLEMS & GROWTH SECTION ===================== -->
<style>
  :root {
    --yellow: #FACC15;
    --yellow-soft: #FEF9C3;
    --yellow-line: #FEF08A;
    --dark: #16130f;
    --muted: #6f6b67;
    --line: #ededed;
    --gray-icon-bg: #f1f1f1;
    --gray-card-bg: #fafafa;
    --page-bg: #ffffff;
  }

  .problems-growth {
    max-width: 1240px;
    margin: 0 auto;
    padding: 80px 32px 90px;
  }

  /* ---------- Header ---------- */
  .problems-growth .head { text-align: center; margin-bottom: 50px; }
  .problems-growth .eyebrow {
    display: flex; align-items: center; justify-content: center;
    gap: 7px; margin-bottom: 22px;
  }
  .problems-growth .eyebrow .line { width: 32px; height: 3px; background: var(--yellow); border-radius: 2px; }
  .problems-growth .eyebrow .dot { width: 7px; height: 7px; background: var(--yellow); border-radius: 50%; }

  .problems-growth .head h1 {
    font-size: clamp(34px, 5.2vw, 64px);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.02;
    margin-bottom: 18px;
  }
  .problems-growth .head p {
    font-size: clamp(16px, 1.6vw, 21px);
    color: var(--muted);
    font-weight: 500;
    max-width: 640px;
    margin: 0 auto;
  }

  /* ---------- Cards grid ---------- */
  .problems-growth .cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
    margin-bottom: 50px;
  }

  .problems-growth .card {
    border-radius: 22px;
    padding: 14px 30px 24px;
    border: 1.5px solid var(--line);
    background: var(--gray-card-bg);
    transition: transform 0.35s cubic-bezier(0.34,1.4,0.64,1), box-shadow 0.35s ease, border-color 0.35s ease;
  }
  .problems-growth .card.solution {
    background: var(--yellow-soft);
    border-color: var(--yellow-line);
  }
  .problems-growth .card:hover {
    transform: translateY(-8px);
    box-shadow: 0 24px 50px rgba(0,0,0,0.10);
  }
  .problems-growth .card.solution:hover {
    box-shadow: 0 24px 50px rgba(242,106,27,0.20);
  }

  .problems-growth .row {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 22px 0;
    position: relative;
    transition: transform 0.3s ease;
  }
  .problems-growth .row:not(:last-child)::after {
    content: "";
    position: absolute;
    left: 70px; right: 0; bottom: 0;
    height: 1px;
    background: var(--line);
  }
  .problems-growth .card.solution .row:not(:last-child)::after { background: var(--yellow-line); }

  /* hover interaction on individual rows */
  .problems-growth .row:not(.row-head):hover { transform: translateX(6px); }
  .problems-growth .row:not(.row-head):hover .icon { transform: scale(1.1) rotate(-5deg); }

  .problems-growth .icon {
    flex-shrink: 0;
    width: 52px; height: 52px;
    border-radius: 50%;
    background: var(--gray-icon-bg);
    display: flex; align-items: center; justify-content: center;
    color: var(--dark);
    transition: transform 0.35s cubic-bezier(0.34,1.56,0.64,1);
  }
  .problems-growth .icon svg { width: 26px; height: 26px; }

  .problems-growth .card.solution .icon { background: #FEF08A; color: var(--yellow); }

  .problems-growth .row-head .icon { background: var(--gray-icon-bg); }
  .problems-growth .card.solution .row-head .icon { background: #FEF08A; }

  .problems-growth .row-text h3 {
    font-size: 19px;
    font-weight: 700;
    line-height: 1.2;
  }
  .problems-growth .row-head .row-text h3 { font-size: 22px; }
  .problems-growth .card.solution .row-head .row-text h3 { color: var(--yellow); }

  .problems-growth .row-text p {
    font-size: 15px;
    color: var(--muted);
    margin-top: 4px;
    line-height: 1.4;
  }

  /* ---------- CTA button ---------- */
  .problems-growth .cta-wrap { display: flex; justify-content: center; }
  .problems-growth .btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 18px 40px;
    background: var(--yellow);
    color: #fff;
    font-family: inherit;
    font-size: 18px;
    font-weight: 700;
    border: 2px solid var(--yellow);
    border-radius: 12px;
    cursor: pointer;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.35s ease, color 0.35s ease, transform 0.3s cubic-bezier(0.34,1.56,0.64,1), box-shadow 0.3s ease;
  }
  .problems-growth .btn svg { width: 20px; height: 20px; transition: transform 0.3s ease; }
  .problems-growth .btn:hover {
    background: #ffffff;
    color: var(--yellow);
    transform: translateY(-3px);
    box-shadow: 0 16px 32px rgba(242,106,27,0.30);
  }
  .problems-growth .btn:hover svg { transform: translateX(6px); }
  .problems-growth .btn:active { transform: translateY(-1px) scale(0.98); }

  /* ---------- TABLET ---------- */
  @media (max-width: 1024px) {
    .problems-growth { padding: 64px 28px 74px; }
    .problems-growth .cards { gap: 22px; }
    .problems-growth .card { padding: 12px 24px 20px; }
    .problems-growth .row { gap: 16px; padding: 20px 0; }
    .problems-growth .icon { width: 48px; height: 48px; }
    .problems-growth .icon svg { width: 24px; height: 24px; }
    .problems-growth .row:not(:last-child)::after { left: 64px; }
  }

  /* ---------- MOBILE ---------- */
  @media (max-width: 760px) {
    .problems-growth { padding: 48px 18px 60px; }
    .problems-growth .head { margin-bottom: 34px; }

    .problems-growth .cards {
      grid-template-columns: 1fr;
      gap: 18px;
      margin-bottom: 36px;
    }
    .problems-growth .card { border-radius: 18px; padding: 8px 20px 16px; }

    .problems-growth .row { gap: 15px; padding: 18px 0; }
    .problems-growth .row:not(:last-child)::after { left: 58px; }
    .problems-growth .icon { width: 46px; height: 46px; }
    .problems-growth .icon svg { width: 23px; height: 23px; }

    .problems-growth .row-text h3 { font-size: 17px; }
    .problems-growth .row-head .row-text h3 { font-size: 20px; }
    .problems-growth .row-text p { font-size: 14px; }

    .problems-growth .btn { font-size: 16px; padding: 16px 30px; width: 100%; justify-content: center; }
    .problems-growth .cta-wrap { padding: 0 4px; }
  }
</style>

