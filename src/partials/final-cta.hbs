<style>
  .cta-section {
    text-align: center;
    padding: 6rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
    overflow: hidden;
  }

  .cta-section .cta-heading {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
