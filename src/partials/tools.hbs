<!-- ===================== TOOLS / PLATFORMS SECTION ===================== -->
<style>
  .platforms-section {
    padding: 5rem 1.5rem;
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    overflow: hidden;
  }

  .platforms-section .section-title {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    color: #111827;
    margin-bottom: 1rem;
    text-align: center;
    letter-spacing: -0.5px;
  }

  .platforms-section .divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 15px;
    margin-bottom: 3.5rem;
    width: 100%;
    max-width: 250px;
  }

  .platforms-section .divider::before,
  .platforms-section .divider::after {
    content: '';
    height: 2px;
    width: 100%;
    background-color: #FACC15;
    border-radius: 2px;
  }

  .platforms-section .divider .dot {
    width: 8px;
    height: 8px;
    background-color: #FACC15;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .platforms-section .platforms-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    width: 100%;
  }

  .platforms-section .platform-card {
    background: #FFFFFF;
    border-radius: 16px;
    padding: 2.5rem 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    border: 1px solid rgba(0, 0, 0, 0.03);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    will-change: transform, opacity;
  }

  .platforms-section .platform-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
    border-color: rgba(249, 115, 22, 0.2);
  }

  .platforms-section .platform-logo {
    height: 55px;
    width: auto;
    max-width: 100px;
    margin-bottom: 1.25rem;
    object-fit: contain;
  }

  .platforms-section .platform-name {
    font-size: 1.05rem;
    font-weight: 500;
    color: #374151;
  }

  @media (max-width: 1024px) {
    .platforms-section .platforms-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 768px) {
    .platforms-section .platforms-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
    .platforms-section .platform-card {
      padding: 2rem 1rem;
    }
  }

  @media (max-width: 480px) {
    .platforms-section .platforms-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

