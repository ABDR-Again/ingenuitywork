<!-- ===================== HEADER SECTION ===================== -->
<style>
  /* =========================================
     Header CSS Variables
     ========================================= */
  :root {
    --bg-white: #FFFFFF;
    --bg-canvas: #F7F7F5;
    --primary-orange: #FACC15;
    --yellow-light: #FEF9C3;
    --text-dark: #111827;
    --text-muted: #6B7280;
    --border-light: #F3F4F6;
    --shadow-sm: 0 4px 6px rgba(0,0,0,0.05);
    --shadow-lg: 0 20px 40px rgba(0,0,0,0.08);
  }

  /* =========================================
     Desktop Header Layout
     ========================================= */
  .site-header {
    background-color: var(--bg-white);
    border-bottom: 1px solid var(--border-light);
    position: sticky;
    top: 0;
    z-index: 100;
    padding: 0 2rem;
    /* Initial GSAP state */
    opacity: 0;
    transform: translateY(-20px);
  }

  .header-container {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 80px;
  }

  /* Logo */
  .logo-container {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--text-dark);
  }
  
  .logo-container img {
    height: 32px;
    width: auto;
  }
  
  .logo-text {
    font-weight: 700;
    font-size: 1.25rem;
    display: flex;
    flex-direction: column;
    line-height: 1;
  }
  .logo-text span {
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 1px;
    color: var(--text-muted);
    margin-top: 4px;
    text-transform: uppercase;
  }

  /* Desktop Navigation */
  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    height: 100%;
  }

  .nav-link {
    text-decoration: none;
    color: var(--text-dark);
    font-weight: 500;
    font-size: 0.95rem;
    display: flex;
    align-items: center;
    gap: 4px;
    height: 100%;
    position: relative;
    transition: color 0.3s ease;
    cursor: pointer;
  }

  .nav-link:hover, .nav-link.active {
    color: var(--primary-orange);
  }

  /* Click micro-interaction */
  .nav-link:active {
    transform: scale(0.95);
  }

  .nav-link svg {
    width: 16px;
    height: 16px;
    transition: transform 0.3s ease;
  }

  .nav-link:hover svg {
    transform: rotate(180deg);
  }

  /* Active Indicator Line */
  .nav-link.active::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: var(--primary-orange);
  }

  /* =========================================
     Desktop Services Dropdown (Mega Menu)
     ========================================= */
  .has-dropdown {
    position: relative;
  }

  .mega-menu {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(15px);
    background: var(--bg-white);
    border-radius: 16px;
    box-shadow: var(--shadow-lg);
    border: 1px solid var(--border-light);
    width: 800px;
    display: flex;
    padding: 1rem;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    z-index: 101;
  }

  /* Triangle pointer on top of dropdown */
  .mega-menu::before {
    content: '';
    position: absolute;
    top: -6px;
    left: 50%;
    transform: translateX(-50%) rotate(45deg);
    width: 12px;
    height: 12px;
    background: var(--bg-white);
    border-top: 1px solid var(--border-light);
    border-left: 1px solid var(--border-light);
  }

  /* Dropdown Left Side */
  .mega-menu-left {
    width: 35%;
    background: linear-gradient(135deg, #FEF9C3 0%, #FFE4D6 100%);
    border-radius: 12px;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
  }

  .mega-menu-left h3 {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 1rem;
    margin-top: 1rem;
    z-index: 2;
  }

  .mega-menu-left p {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-bottom: 2rem;
    z-index: 2;
  }

  .mega-menu-left a {
    color: var(--primary-orange);
    font-weight: 700;
    font-size: 0.9rem;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 5px;
    z-index: 2;
  }

  .mega-menu-left a:hover { text-decoration: underline; }

  /* Decorative graphic */
  .mega-bg-graphic {
    position: absolute;
    bottom: -20px;
    left: -20px;
    width: 150%;
    opacity: 0.5;
    z-index: 1;
  }

  /* Dropdown Right Side (Services List) */
  .mega-menu-right {
    width: 65%;
    padding: 1rem 1rem 1rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .service-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 1rem;
    border-radius: 12px;
    text-decoration: none;
    color: var(--text-dark);
    transition: all 0.3s ease;
  }

  .service-item:hover {
    background-color: var(--bg-canvas);
  }
  
  .service-item:active {
    transform: scale(0.98);
  }

  .service-icon {
    width: 40px;
    height: 40px;
    background: var(--bg-white);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-sm);
    flex-shrink: 0;
    color: var(--primary-orange);
  }
  .service-icon svg { width: 20px; height: 20px; }

  .service-text { flex: 1; }
  .service-text h4 { font-size: 0.95rem; font-weight: 700; margin-bottom: 2px; }
  .service-text p { font-size: 0.8rem; color: var(--text-muted); }

  .service-arrow {
    color: var(--text-muted);
    opacity: 0;
    transform: translateX(-10px);
    transition: all 0.3s ease;
  }

  .service-item:hover .service-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  /* =========================================
     Buttons
     ========================================= */
  .btn-talk {
    background-color: var(--primary-orange);
    color: var(--bg-white);
    border: 2px solid var(--primary-orange);
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transition: all 0.3s ease;
    text-decoration: none;
  }

  /* Vibration Keyframes */
  @keyframes vibrate {
    0% { transform: translate(0, 0); }
    20% { transform: translate(-2px, 2px); }
    40% { transform: translate(-2px, -2px); }
    60% { transform: translate(2px, 2px); }
    80% { transform: translate(2px, -2px); }
    100% { transform: translate(0, 0); }
  }

  .btn-talk:hover {
    background-color: var(--bg-white);
    color: var(--primary-orange);
    animation: vibrate 0.15s linear infinite;
  }

  /* Hamburger Menu Button */
  .hamburger {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
  }
  .hamburger svg { width: 28px; height: 28px; stroke: var(--text-dark); }

  /* =========================================
     Mobile Full Viewport Menu
     ========================================= */
  .mobile-menu-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    background-color: #FAFAFA;
    z-index: 999;
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    overflow-y: auto;
  }

  .mobile-menu-overlay.open {
    transform: translateX(0);
  }

  /* Mobile Header */
  .mobile-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 1.5rem;
    background: var(--bg-white);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .btn-close {
    background: var(--bg-white);
    border: 1px solid var(--border-light);
    border-radius: 50%;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--primary-orange);
  }
  .btn-close:active { transform: scale(0.9); }

  /* Mobile Menu Content */
  .mobile-content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .menu-category {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .category-label {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--primary-orange);
    letter-spacing: 1px;
    margin-bottom: 0.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .category-label::after {
    content: '::';
    color: #D1D5DB;
    letter-spacing: 2px;
  }

  .mobile-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    border-radius: 12px;
    text-decoration: none;
    color: var(--text-dark);
    font-weight: 700;
    font-size: 1.05rem;
    background-color: var(--bg-white);
    border: 1px solid transparent;
    transition: transform 0.2s;
  }

  .mobile-link:active { transform: scale(0.98); }

  .mobile-link-left {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .mobile-link svg.icon { width: 20px; height: 20px; color: var(--text-dark); }
  .mobile-link svg.arrow { width: 18px; height: 18px; color: var(--text-muted); }

  /* Highlighted Mobile Link */
  .mobile-link.highlight {
    background-color: var(--yellow-light);
    color: var(--primary-orange);
    border-color: #FEEBC8;
  }
  .mobile-link.highlight svg.icon, .mobile-link.highlight svg.arrow {
    color: var(--primary-orange);
  }

  /* Mobile Bottom Cards */
  .mobile-cards {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1rem;
    padding-bottom: 2rem;
  }

  .card-primary {
    background: linear-gradient(135deg, #FEF9C3 0%, #FFE4D6 100%);
    border-radius: 16px;
    padding: 1.5rem;
    border: 1px solid #FEEBC8;
    position: relative;
    overflow: hidden;
  }
  
  .card-primary-top {
    display: flex;
    gap: 1rem;
    align-items: center;
    margin-bottom: 1rem;
    z-index: 2;
    position: relative;
  }
  
  .card-icon-circle {
    width: 48px;
    height: 48px;
    background: var(--primary-orange);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    box-shadow: 0 4px 12px rgba(240, 90, 40, 0.3);
  }
  
  .card-text h4 { font-size: 1rem; font-weight: 700; margin-bottom: 2px;}
  .card-text p { font-size: 0.8rem; color: var(--text-muted); }

  .btn-card {
    background: var(--primary-orange);
    color: white;
    border: none;
    border-radius: 8px;
    padding: 0.75rem 1rem;
    font-weight: 600;
    font-size: 0.9rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: max-content;
    gap: 0.5rem;
    margin-left: auto;
    z-index: 2;
    position: relative;
  }

  /* Card secondary */
  .card-secondary {
    background: var(--bg-white);
    border-radius: 16px;
    padding: 1.5rem;
    border: 1px solid var(--border-light);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .card-secondary .card-icon-circle {
    background: var(--bg-canvas);
    color: var(--primary-orange);
    box-shadow: none;
  }

  .btn-card-outline {
    background: transparent;
    color: var(--primary-orange);
    border: 1px solid var(--primary-orange);
    border-radius: 8px;
    padding: 0.6rem 1rem;
    font-weight: 600;
    font-size: 0.9rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* =========================================
     Responsive Rules
     ========================================= */
  @media (max-width: 1024px) {
    .desktop-nav, .btn-talk.desktop-only { display: none; }
    .hamburger { display: block; }
  }
</style>

