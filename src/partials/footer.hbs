<!-- ===================== FOOTER SECTION ===================== -->
<style>
  .new-footer {
    --ft-bg: #FFFFFF;
    --ft-text-main: #111827;
    --ft-text-muted: #6B7280;
    --ft-orange: #F97316;
    --ft-orange-light: #FFF7ED;
    --ft-border: #F3F4F6;
    --ft-divider: #E5E7EB;
  }

  .new-footer {
    background-color: var(--ft-bg); padding: 4rem 2rem 2rem 2rem;
    border-top: 1px solid var(--ft-divider); max-width: 1400px; margin: 0 auto;
  }

  .new-footer .ft-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 3rem; }
  .new-footer .ft-brand { display: flex; flex-direction: column; gap: 0.5rem; }
  .new-footer .ft-logo { height: 40px; width: auto; object-fit: contain; }
  .new-footer .ft-tagline { color: var(--ft-text-muted); font-size: 0.95rem; }
  .new-footer .ft-mobile-tagline { display: none; }

  .new-footer .ft-newsletter { display: flex; flex-direction: column; gap: 1rem; min-width: 450px; }
  .new-footer .ft-newsletter-header { display: flex; align-items: center; gap: 0.5rem; font-weight: 500; font-size: 1.05rem; }
  .new-footer .ft-newsletter-header svg { color: var(--ft-orange); width: 24px; height: 24px; }
  .new-footer .ft-newsletter-form { display: flex; gap: 0.5rem; }
  .new-footer .ft-newsletter-form input {
    flex: 1; padding: 0.75rem 1rem; border: 1px solid var(--ft-divider); border-radius: 8px;
    font-family: inherit; font-size: 0.95rem; outline: none; transition: border-color 0.3s;
  }
  .new-footer .ft-newsletter-form input:focus { border-color: var(--ft-orange); }
  .new-footer .ft-btn-subscribe {
    background-color: var(--ft-orange); color: white; border: none; border-radius: 8px;
    padding: 0 1.5rem; font-weight: 500; font-family: inherit; font-size: 0.95rem;
    cursor: pointer; display: flex; align-items: center; gap: 0.5rem; transition: all 0.3s ease;
  }
  .new-footer .ft-btn-subscribe:hover { background-color: #E0600D; }

  .new-footer .ft-divider { height: 1px; width: 100%; background-color: var(--ft-divider); margin: 2.5rem 0; position: relative; }
  .new-footer .ft-top-divider::before {
    content: ''; position: absolute; top: -6px; left: 50%; transform: translateX(-50%) rotate(45deg);
    width: 12px; height: 12px; background-color: var(--ft-bg);
    border-right: 1px solid var(--ft-divider); border-bottom: 1px solid var(--ft-divider);
  }

  .new-footer .ft-main { display: grid; grid-template-columns: 1fr 1.5fr 1fr 1fr 1fr; gap: 2rem; }

  .new-footer .ft-col { display: flex; flex-direction: column; gap: 1.5rem; opacity: 0; transform: translateY(20px); }
  .new-footer .ft-col-header { display: flex; align-items: center; gap: 0.5rem; color: var(--ft-text-main); }
  .new-footer .ft-col-header h3 { font-size: 1.1rem; font-weight: 700; }
  .new-footer .ft-header-icon { width: 24px; height: 24px; padding: 3px; border-radius: 6px; background-color: var(--ft-orange-light); color: var(--ft-orange); }
  .new-footer .ft-chevron { display: none; margin-left: auto; width: 20px; height: 20px; color: var(--ft-text-main); transition: transform 0.3s ease; }

  .new-footer .ft-col-content { display: flex; flex-direction: column; gap: 0.5rem; }
  .new-footer .ft-link {
    color: var(--ft-text-main); text-decoration: none; font-size: 0.95rem;
    padding: 0.5rem 0.75rem; border-radius: 6px; margin-left: -0.75rem;
    transition: all 0.2s ease; display: inline-flex; align-items: center;
    justify-content: space-between; width: max-content; min-width: 120px;
  }
  .new-footer .ft-link svg { width: 16px; height: 16px; opacity: 0; transform: translateX(-5px); transition: all 0.2s ease; }
  .new-footer .ft-link:hover { background-color: var(--ft-orange-light); color: var(--ft-orange); }
  .new-footer .ft-link:hover svg { opacity: 1; transform: translateX(0); }
  .new-footer .ft-link.active-pill { background-color: var(--ft-orange); color: white; }
  .new-footer .ft-link.active-pill svg { opacity: 1; transform: translateX(0); }
  .new-footer .ft-link.active-text { color: var(--ft-orange); }
  .new-footer .ft-link.active-text svg { opacity: 1; transform: translateX(0); }

  .new-footer .ft-contact-link { display: flex; align-items: center; gap: 0.75rem; color: var(--ft-text-main); text-decoration: none; font-size: 0.95rem; margin-bottom: 0.5rem; transition: color 0.2s; }
  .new-footer .ft-contact-link:hover { color: var(--ft-orange); }
  .new-footer .ft-contact-link svg { width: 18px; height: 18px; }

  .new-footer .ft-social-title { font-size: 0.9rem; margin: 1.5rem 0 0.5rem 0; color: var(--ft-text-muted); }
  .new-footer .ft-social-links { display: flex; gap: 0.5rem; }
  .new-footer .ft-social-icon {
    width: 36px; height: 36px; border-radius: 50%; border: 1px solid var(--ft-divider);
    display: flex; align-items: center; justify-content: center;
    color: var(--ft-text-main); text-decoration: none; transition: all 0.3s ease;
  }
  .new-footer .ft-social-icon:hover { background-color: var(--ft-orange); border-color: var(--ft-orange); color: white; transform: translateY(-2px); box-shadow: 0 4px 10px rgba(249, 115, 22, 0.2); }
  .new-footer .ft-social-icon svg { width: 16px; height: 16px; fill: currentColor; }

  .new-footer .ft-created-by { margin-top: 1.5rem; font-size: 0.9rem; }
  .new-footer .ft-created-by span { color: var(--ft-orange); font-weight: 500; }

  .new-footer .ft-bottom { display: flex; justify-content: space-between; align-items: center; font-size: 0.85rem; color: var(--ft-text-muted); }
  .new-footer .ft-bottom-tags { display: flex; align-items: center; gap: 1.5rem; }
  .new-footer .ft-bottom-tags span { display: flex; align-items: center; gap: 0.5rem; }
  .new-footer .ft-bottom-tags span::before { content: ''; display: inline-block; width: 4px; height: 4px; border-radius: 50%; background-color: var(--ft-orange); }
  .new-footer .ft-tag-highlight { color: var(--ft-text-main); display: flex; align-items: center; gap: 0.5rem; }

  @media (max-width: 768px) {
    .new-footer { padding: 2rem 1.5rem; background-color: #FAFAFA; }
    .new-footer .ft-newsletter { display: none; }
    .new-footer .ft-desktop-tagline { display: none; }
    .new-footer .ft-mobile-tagline { display: block; text-align: center; margin-top: 0.5rem; font-size: 0.95rem; line-height: 1.5; }
    .new-footer .ft-brand { align-items: center; margin-bottom: 1rem; }
    .new-footer .ft-logo { height: 45px; }
    .new-footer .ft-top-divider { display: none; }
    .new-footer .ft-main { display: flex; flex-direction: column; gap: 0.75rem; }
    .new-footer .ft-col { background-color: #FFFFFF; border: 1px solid var(--ft-border); border-radius: 12px; box-shadow: 0 4px 10px rgba(0, 0, 0, 0.02); padding: 0; gap: 0; }
    .new-footer .ft-col-header { padding: 1.25rem; cursor: pointer; border-radius: 12px; transition: background-color 0.2s; user-select: none; }
    .new-footer .ft-chevron { display: block; }
    .new-footer .ft-col.active .ft-chevron { transform: rotate(180deg); }
    .new-footer .ft-col.active .ft-col-header { border-bottom: 1px solid var(--ft-border); border-bottom-left-radius: 0; border-bottom-right-radius: 0; }
    .new-footer .ft-col-content { display: none; padding: 1rem 1.25rem; }
    .new-footer .ft-link { margin-left: 0; width: 100%; }
    .new-footer .ft-bottom { flex-direction: column; justify-content: center; text-align: center; gap: 1.5rem; margin-top: -1rem; }
    .new-footer .ft-bottom-tags { justify-content: center; gap: 2rem; }
    .new-footer .ft-tag-highlight { display: none; }
  }
</style>

