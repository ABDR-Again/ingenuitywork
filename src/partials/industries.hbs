<!-- ===================== INDUSTRIES SECTION ===================== -->
<style>
  .industries-section {
    --ind-bg-canvas: #FAFAFA;
    --ind-bg-white: #FFFFFF;
    --ind-text-dark: #111827;
    --ind-text-muted: #6B7280;
    --ind-primary-yellow: #FACC15;
    --ind-yellow-light: #FEF9C3;
    --ind-border-color: #E5E7EB;
  }

  .industries-section {
    padding: 6rem 2rem;
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 4rem;
    align-items: center;
    overflow: hidden;
  }

  .industries-section .content-col {
    display: flex; flex-direction: column; gap: 1.5rem;
  }

  .industries-section .section-tag {
    font-size: 0.8rem; font-weight: 700; color: var(--ind-primary-yellow);
    text-transform: uppercase; letter-spacing: 1.5px;
    display: flex; align-items: center; gap: 15px;
  }
  .industries-section .section-tag::after {
    content: ''; height: 2px; width: 40px; background-color: var(--ind-primary-yellow);
  }

  .industries-section .main-heading {
    font-size: clamp(2.5rem, 4vw, 3.5rem); font-weight: 700; line-height: 1.1; letter-spacing: -1px;
  }
  .industries-section .main-heading span { color: var(--ind-primary-yellow); }

  .industries-section .sub-heading {
    font-size: 1.1rem; color: var(--ind-text-muted); line-height: 1.6;
  }

  .industries-section .info-box {
    display: flex; align-items: flex-start; gap: 1rem;
    background-color: var(--ind-bg-white); border: 1px solid var(--ind-border-color);
    padding: 1.5rem; border-radius: 12px; box-shadow: 0 4px 10px rgba(0,0,0,0.02); margin-top: 1rem;
  }
  .industries-section .info-icon { width: 24px; height: 24px; color: var(--ind-primary-yellow); flex-shrink: 0; }
  .industries-section .info-text { font-size: 0.95rem; color: var(--ind-text-muted); line-height: 1.5; }

  .industries-section .slider-col { position: relative; width: 100%; }

  .industries-section .cards-track {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.25rem;
  }

  .industries-section .industry-card {
    background-color: var(--ind-bg-white); border: 1px solid var(--ind-border-color);
    border-radius: 16px; padding: 2rem 1rem;
    display: flex; flex-direction: column; align-items: center; text-align: center;
    text-decoration: none; color: var(--ind-text-dark); cursor: pointer;
    position: relative; overflow: hidden;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    opacity: 0; transform: scale(0.9);
  }

  .industries-section .icon-wrapper {
    width: 70px; height: 70px; border-radius: 50%;
    background-color: var(--ind-bg-canvas);
    display: flex; justify-content: center; align-items: center;
    margin-bottom: 1.5rem; color: var(--ind-text-dark);
    border: 1px solid var(--ind-border-color); transition: all 0.3s ease;
  }
  .industries-section .icon-wrapper svg { width: 32px; height: 32px; stroke: currentColor; transition: all 0.3s ease; }

  .industries-section .card-divider {
    width: 20px; height: 2px; background-color: var(--ind-border-color);
    margin-bottom: 1rem; transition: all 0.3s ease;
  }
  .industries-section .industry-card h3 { font-size: 1rem; font-weight: 700; line-height: 1.3; }

  .industries-section .card-badge {
    position: absolute; top: 15px; left: 15px;
    background-color: var(--ind-primary-yellow); color: var(--ind-bg-white);
    font-size: 0.75rem; font-weight: 700; padding: 4px 8px; border-radius: 12px;
    opacity: 0; transform: translateY(-10px); transition: all 0.3s ease;
  }
  .industries-section .card-sparkle {
    position: absolute; top: 15px; right: 15px; color: var(--ind-primary-yellow);
    opacity: 0; transition: all 0.3s ease;
  }

  .industries-section .industry-card:hover {
    border-color: var(--ind-primary-yellow);
    box-shadow: 0 10px 30px rgba(240, 90, 40, 0.1);
    transform: translateY(-5px) !important;
  }
  .industries-section .industry-card:hover .icon-wrapper {
    background-color: var(--ind-yellow-light); border-color: var(--ind-yellow-light); color: var(--ind-primary-yellow);
  }
  .industries-section .industry-card:hover .card-divider { background-color: var(--ind-primary-yellow); width: 30px; }
  .industries-section .industry-card:hover .card-badge { opacity: 1; transform: translateY(0); }
  .industries-section .industry-card:hover .card-sparkle { opacity: 1; }
  .industries-section .industry-card:active { transform: scale(0.96) !important; }

  .industries-section .mobile-controls {
    display: none; justify-content: center; align-items: center; gap: 1rem; margin-top: 2rem;
  }
  .industries-section .slider-arrow {
    background: var(--ind-bg-white); border: 1px solid var(--ind-border-color);
    width: 48px; height: 48px; border-radius: 50%;
    display: flex; justify-content: center; align-items: center;
    cursor: pointer; color: var(--ind-text-dark); transition: all 0.2s ease;
  }
  .industries-section .slider-arrow:hover { background: var(--ind-primary-yellow); border-color: var(--ind-primary-yellow); color: var(--ind-bg-white); }
  .industries-section .slider-arrow:active { transform: scale(0.9); }
  .industries-section .slider-arrow svg { width: 20px; height: 20px; stroke: currentColor; }

  @media (max-width: 1024px) {
    .industries-section { grid-template-columns: 1fr; gap: 3rem; }
    .industries-section .content-col { text-align: center; align-items: center; }
    .industries-section .section-tag::after { display: none; }
    .industries-section .info-box { text-align: left; max-width: 600px; }
    .industries-section .cards-track { grid-template-columns: repeat(4, 1fr); }
  }

  @media (max-width: 768px) {
    .industries-section { padding: 4rem 1.5rem; gap: 2rem; }
    .industries-section .hide-mobile { display: none !important; }
    .industries-section .content-col { align-items: flex-start; text-align: left; }
    .industries-section .main-heading { font-size: 2.25rem; }
    .industries-section .cards-track {
      display: flex; overflow-x: auto; scroll-behavior: smooth; gap: 1rem;
      padding-bottom: 1rem; scrollbar-width: none; -ms-overflow-style: none;
    }
    .industries-section .cards-track::-webkit-scrollbar { display: none; }
    .industries-section .industry-card { flex: 0 0 100%; min-height: 250px; justify-content: center; }
    .industries-section .mobile-controls { display: flex; }
  }
</style>

