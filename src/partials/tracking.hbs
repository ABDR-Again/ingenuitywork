<!-- ===================== TRACKING & ANALYTICS SECTION ===================== -->
<style>
  .tracking-section {
    padding: 8rem 2rem;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
  }

  .tracking-section .ellipse-wrapper {
    position: relative;
    width: 100%;
    max-width: 950px;
    height: 550px;
    margin: 0 auto;
  }

  .tracking-section .ellipse-bg {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    z-index: 0;
    overflow: visible;
  }

  .tracking-section .center-content {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    max-width: 480px;
    z-index: 10;
    width: 100%;
  }

  .tracking-section .target-icon {
    width: 48px; height: 48px;
    color: #F97316;
    margin-bottom: 1rem;
  }

  .tracking-section .center-content h2 {
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    font-weight: 800;
    line-height: 1.2;
    color: #111827;
    margin-bottom: 1.5rem;
    letter-spacing: -0.5px;
  }

  .tracking-section .divider {
    width: 60px; height: 3px;
    background-color: #F97316;
    margin: 0 auto 1.5rem auto;
    border-radius: 2px;
  }

  .tracking-section .center-content p {
    font-size: 1.05rem;
    color: #4B5563;
    line-height: 1.6;
  }

  .tracking-section .card-position {
    position: absolute;
    transform: translate(-50%, -50%);
    z-index: 5;
  }

  .tracking-section .pos-1 { left: 50%; top: 0%; }
  .tracking-section .pos-2 { left: 85.35%; top: 14.65%; }
  .tracking-section .pos-3 { left: 100%; top: 50%; }
  .tracking-section .pos-4 { left: 85.35%; top: 85.35%; }
  .tracking-section .pos-5 { left: 50%; top: 100%; }
  .tracking-section .pos-6 { left: 14.65%; top: 85.35%; }
  .tracking-section .pos-7 { left: 0%; top: 50%; }
  .tracking-section .pos-8 { left: 14.65%; top: 14.65%; }

  .tracking-section .track-card {
    background-color: #FFFFFF;
    padding: 1.25rem 1.5rem;
    border-radius: 16px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.04);
    border: 1px solid rgba(0,0,0,0.02);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 190px;
    text-align: center;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.3s ease;
    will-change: transform;
  }

  .tracking-section .track-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 15px 35px rgba(249, 115, 22, 0.12);
  }

  .tracking-section .card-icon {
    height: 40px; width: auto; max-width: 60px;
    margin-bottom: 0.75rem;
    object-fit: contain;
    color: #F97316;
  }

  .tracking-section .track-card span {
    font-size: 0.85rem;
    font-weight: 600;
    color: #111827;
  }

  @media (max-width: 1024px) {
    .tracking-section { padding: 5rem 1.5rem; }
    .tracking-section .ellipse-wrapper {
      display: flex;
      flex-direction: column;
      height: auto;
      max-width: 800px;
    }
    .tracking-section .ellipse-bg { display: none; }
    .tracking-section .center-content {
      position: static;
      transform: none;
      order: -1;
      margin: 0 auto 4rem auto;
    }
    .tracking-section .card-position {
      position: static;
      transform: none;
      width: 100%;
    }
    .tracking-section .cards-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
      gap: 1.5rem;
      width: 100%;
    }
    .tracking-section .track-card {
      width: 100%; height: 100%;
    }
  }
</style>

<section class="tracking-section">
  <div class="ellipse-wrapper cards-grid">
    
    <svg class="ellipse-bg" xmlns="http://www.w3.org/2000/svg">
      <ellipse cx="50%" cy="50%" rx="49.5%" ry="49.5%" fill="none" stroke="#E5E7EB" stroke-width="2" stroke-dasharray="8 8"/>
      <circle cx="50%" cy="0%" r="5" fill="#F97316"/>
      <circle cx="85.35%" cy="14.65%" r="5" fill="#F97316"/>
      <circle cx="100%" cy="50%" r="5" fill="#F97316"/>
      <circle cx="85.35%" cy="85.35%" r="5" fill="#F97316"/>
      <circle cx="50%" cy="100%" r="5" fill="#F97316"/>
      <circle cx="14.65%" cy="85.35%" r="5" fill="#F97316"/>
      <circle cx="0%" cy="50%" r="5" fill="#F97316"/>
