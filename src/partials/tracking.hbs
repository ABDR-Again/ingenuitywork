      </svg>
      <h2 class="track-gsap-center">Every Click, Lead, Call, and Form Submission Should Be Tracked Properly</h2>
      <div class="divider track-gsap-center"></div>
      <p class="track-gsap-center">We set up GTM, GA4, Google Ads conversions, Meta Pixel, form tracking, button clicks, call tracking, and reporting dashboards so you know what is working.</p>
    </div>

    <div class="card-position pos-1">
      <div class="track-card track-gsap-card">
        <img src="https://www.vectorlogo.zone/logos/googletagmanager/googletagmanager-icon.svg" alt="Google Tag Manager" class="card-icon">
        <span>Google Tag Manager</span>
      </div>
    </div>

    <div class="card-position pos-2">
      <div class="track-card track-gsap-card">
        <img src="https://www.vectorlogo.zone/logos/google_ads/google_ads-icon.svg" alt="Google Ads" class="card-icon">
        <span>Google Ads Conversions</span>
      </div>
    </div>

    <div class="card-position pos-3">
      <div class="track-card track-gsap-card">
        <svg class="card-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
          <path d="M9 15l2 2 4-4"></path>
        </svg>
        <span>Form Submission Tracking</span>
      </div>
    </div>

    <div class="card-position pos-4">
      <div class="track-card track-gsap-card">
        <svg class="card-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
          <circle cx="9" cy="7" r="4"></circle>
          <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
          <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
        </svg>
        <span>Retargeting Audiences</span>
      </div>
    </div>

    <div class="card-position pos-5">
      <div class="track-card track-gsap-card">
        <svg class="card-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="20" x2="18" y2="10"></line>
          <line x1="12" y1="20" x2="12" y2="4"></line>
          <line x1="6" y1="20" x2="6" y2="14"></line>
        </svg>
        <span>Monthly Reporting</span>
      </div>
    </div>

    <div class="card-position pos-6">
      <div class="track-card track-gsap-card">
        <svg class="card-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
        </svg>
        <span>Call Button Tracking</span>
      </div>
    </div>

    <div class="card-position pos-7">
      <div class="track-card track-gsap-card">
        <img src="https://www.vectorlogo.zone/logos/meta/meta-icon.svg" alt="Meta Pixel" class="card-icon">
        <span>Meta Pixel</span>
      </div>
    </div>

    <div class="card-position pos-8">
      <div class="track-card track-gsap-card">
        <img src="https://www.vectorlogo.zone/logos/google_analytics/google_analytics-icon.svg" alt="GA4 Events" class="card-icon">
        <span>GA4 Events</span>
      </div>
    </div>

  </div>
</section>
