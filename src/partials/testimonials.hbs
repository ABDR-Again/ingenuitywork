<!-- ===================== TESTIMONIALS SECTION ===================== -->
<style>
  .testimonials-section {
    --ts-orange: #F2701F;
    --ts-dark: #14110F;
    --ts-muted: #6b6764;
    --ts-card-bg: #ffffff;
    --ts-card-border: #ededed;
    --ts-star: #F2701F;
  }

  .testimonials-section .ts-inner {
    max-width: 1340px; margin: 0 auto; padding: 80px 32px;
    display: grid; grid-template-columns: 0.85fr 1.15fr; gap: 56px; align-items: start;
  }

  /* LEFT COLUMN */
  .testimonials-section .ts-intro { position: sticky; top: 60px; }

  .testimonials-section .ts-eyebrow {
    display: flex; align-items: center; gap: 6px; margin-bottom: 28px;
  }
  .testimonials-section .ts-eyebrow .ts-line { width: 34px; height: 3px; background: var(--ts-orange); border-radius: 2px; }
  .testimonials-section .ts-eyebrow .ts-dot { width: 6px; height: 6px; background: var(--ts-orange); border-radius: 50%; }

  .testimonials-section .ts-intro h2 {
    font-size: clamp(34px, 3.6vw, 52px); font-weight: 800; line-height: 1.08;
    letter-spacing: -0.02em; margin-bottom: 22px;
  }
  .testimonials-section .ts-intro h2 .accent { color: var(--ts-orange); }

  .testimonials-section .ts-intro p {
    font-size: 17px; line-height: 1.6; color: var(--ts-muted); max-width: 380px; margin-bottom: 34px;
  }

  .testimonials-section .ts-btn {
    position: relative; display: inline-flex; align-items: center; gap: 10px;
    padding: 16px 30px; background: var(--ts-orange); color: #fff;
    font-family: inherit; font-size: 15.5px; font-weight: 700;
    border: none; border-radius: 10px; cursor: pointer; text-decoration: none;
    overflow: hidden; transition: transform 0.3s cubic-bezier(0.34,1.56,0.64,1), box-shadow 0.3s ease; z-index: 0;
  }
  .testimonials-section .ts-btn svg { width: 16px; height: 16px; transition: transform 0.3s ease; }
  .testimonials-section .ts-btn::after {
    content: ""; position: absolute; inset: 0; background: rgba(0,0,0,0.14);
    transform: translateX(-101%); transition: transform 0.45s cubic-bezier(0.65,0,0.35,1); z-index: -1;
  }
  .testimonials-section .ts-btn:hover { transform: translateY(-3px); box-shadow: 0 14px 28px rgba(242,112,31,0.4); }
  .testimonials-section .ts-btn:hover::after { transform: translateX(0); }
  .testimonials-section .ts-btn:hover svg { transform: translateX(5px); }

  .testimonials-section .ts-clients { display: flex; align-items: center; gap: 16px; margin-top: 40px; }
  .testimonials-section .ts-avatars { display: flex; }
  .testimonials-section .ts-avatars .ts-av {
    width: 40px; height: 40px; border-radius: 50%; border: 2.5px solid #fff;
    margin-left: -12px; display: flex; align-items: center; justify-content: center;
    font-size: 13px; font-weight: 700; color: #fff;
  }
  .testimonials-section .ts-avatars .ts-av:first-child { margin-left: 0; }
  .testimonials-section .ts-av.a1 { background: #e76f51; }
  .testimonials-section .ts-av.a2 { background: #2a9d8f; }
  .testimonials-section .ts-av.a3 { background: #457b9d; }
  .testimonials-section .ts-av.a4 { background: #8d5b9e; }
  .testimonials-section .ts-av.count { background: #ffe6d2; color: var(--ts-orange); font-size: 12px; }
  .testimonials-section .ts-clients-text strong { display: block; font-size: 16px; font-weight: 700; }
  .testimonials-section .ts-clients-text span { font-size: 13.5px; color: var(--ts-muted); }

  /* RIGHT COLUMN (marquee) */
  .testimonials-section .ts-reviews-viewport {
    position: relative; height: 760px; overflow: hidden;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 7%, #000 93%, transparent 100%);
            mask-image: linear-gradient(to bottom, transparent 0%, #000 7%, #000 93%, transparent 100%);
  }

  .testimonials-section .ts-marquee { display: flex; flex-direction: column; gap: 18px; will-change: transform; }
  .testimonials-section .ts-marquee-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; align-items: start; }
  .testimonials-section .ts-mcol { display: flex; flex-direction: column; gap: 18px; }

  /* Review card */
  .testimonials-section .ts-review {
    background: var(--ts-card-bg); border: 1px solid var(--ts-card-border);
    border-radius: 16px; padding: 22px; box-shadow: 0 6px 20px rgba(0,0,0,0.04); break-inside: avoid;
  }
  .testimonials-section .ts-review-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }
  .testimonials-section .ts-platform { display: flex; align-items: center; gap: 7px; }
  .testimonials-section .ts-platform .ts-logo {
    width: 22px; height: 22px; border-radius: 5px;
    display: flex; align-items: center; justify-content: center;
    font-size: 12px; font-weight: 800; color: #fff;
  }
  .testimonials-section .ts-logo.google { background: #fff; border: 1px solid #eee; color: #4285F4; font-family: Georgia, serif; }
  .testimonials-section .ts-logo.fiverr { background: #1dbf73; }
  .testimonials-section .ts-platform .ts-pname { font-size: 12.5px; color: var(--ts-muted); font-weight: 500; }
  .testimonials-section .ts-stars { color: var(--ts-star); font-size: 14px; letter-spacing: 1px; margin-bottom: 12px; }
  .testimonials-section .ts-review p.ts-quote { font-size: 15px; line-height: 1.5; font-weight: 600; color: #2c2826; margin-bottom: 18px; }
  .testimonials-section .ts-reviewer { display: flex; align-items: center; gap: 12px; }
  .testimonials-section .ts-rav {
    width: 40px; height: 40px; border-radius: 50%; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 700; color: #fff;
  }
  .testimonials-section .ts-reviewer-info strong { display: block; font-size: 14.5px; font-weight: 700; }
  .testimonials-section .ts-reviewer-info span { display: block; font-size: 12px; color: var(--ts-muted); line-height: 1.35; }

  /* Video review card */
  .testimonials-section .ts-video-review {
    position: relative; border-radius: 16px; overflow: hidden; background: #1a1a1a;
    min-height: 250px; display: flex; flex-direction: column; justify-content: flex-end;
    box-shadow: 0 6px 20px rgba(0,0,0,0.12);
  }
  .testimonials-section .ts-video-review .ts-poster-fallback { position: absolute; inset: 0; background: linear-gradient(160deg,#3a3a3a,#1a1a1a); z-index: 0; }
  .testimonials-section .ts-video-review .ts-overlay {
    position: relative; z-index: 2; padding: 20px;
    background: linear-gradient(to top, rgba(0,0,0,0.85), rgba(0,0,0,0) 100%); color: #fff;
  }
  .testimonials-section .ts-play-btn {
    position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%);
    width: 54px; height: 54px; border-radius: 50%; background: var(--ts-orange);
    border: none; cursor: pointer; z-index: 3;
    display: flex; align-items: center; justify-content: center;
    transition: transform 0.3s cubic-bezier(0.34,1.56,0.64,1), box-shadow 0.3s ease;
  }
  .testimonials-section .ts-play-btn svg { width: 20px; height: 20px; margin-left: 3px; }
  .testimonials-section .ts-play-btn:hover { transform: translate(-50%,-50%) scale(1.12); box-shadow: 0 0 0 8px rgba(242,112,31,0.25); }
  .testimonials-section .ts-video-review .ts-vquote { font-size: 14.5px; font-weight: 600; margin-bottom: 10px; line-height: 1.4; }
  .testimonials-section .ts-video-review .ts-vstars { color: var(--ts-star); font-size: 13px; letter-spacing: 1px; margin-bottom: 8px; }
  .testimonials-section .ts-video-review .ts-vmeta { display: flex; align-items: center; justify-content: space-between; }
  .testimonials-section .ts-video-review .ts-vmeta strong { font-size: 13.5px; display: block; }
  .testimonials-section .ts-video-review .ts-vmeta span { font-size: 11.5px; opacity: 0.8; }
  .testimonials-section .ts-video-review .ts-vtag { font-size: 11px; opacity: 0.75; display: flex; align-items: center; gap: 5px; }

  @media (max-width: 1024px) {
    .testimonials-section .ts-inner { grid-template-columns: 1fr; gap: 44px; }
    .testimonials-section .ts-intro { position: static; }
    .testimonials-section .ts-intro p { max-width: none; }
    .testimonials-section .ts-reviews-viewport { height: auto; overflow: visible; -webkit-mask-image: none; mask-image: none; }
    .testimonials-section .ts-marquee { transform: none !important; }
    .testimonials-section .ts-marquee .ts-loop-clone { display: none; }
  }

  @media (max-width: 700px) {
    .testimonials-section .ts-inner { padding: 54px 20px; gap: 34px; }
    .testimonials-section .ts-intro h2 { font-size: 32px; }
  }
</style>

