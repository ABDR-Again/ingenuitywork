<!-- ===================== HERO SECTION ===================== -->
<style>
  :root {
    --yellow: #FACC15;
    --dark: #14110d;
    --muted: #6b6661;
    --line: #e9e6e2;
    --page-bg: #ffffff;
    --strip-bg: #f4f2ef;
  }

  .hero {
    max-width: 1440px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    min-height: 620px;
    position: relative;
  }

  /* ================= LEFT ================= */
  .hero .left {
    padding: 70px 40px 70px 72px;
  }

  .hero .eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 26px;
  }
  .hero .eyebrow .dot { width: 9px; height: 9px; border-radius: 50%; background: var(--yellow); }
  .hero .eyebrow span {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.22em;
    color: var(--yellow);
    text-transform: uppercase;
  }

  .hero .left h1 {
    font-size: clamp(40px, 5vw, 70px);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 0.98;
    margin-bottom: 26px;
  }

  .hero .left p {
    font-size: clamp(15px, 1.3vw, 18px);
    color: var(--muted);
    line-height: 1.6;
    max-width: 430px;
    margin-bottom: 38px;
  }

  /* ---- Actions ---- */
  .hero .actions {
    display: flex;
    align-items: center;
    gap: 22px;
    flex-wrap: wrap;
  }

  .hero .btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 28px;
    font-family: inherit;
    font-size: 15px;
    font-weight: 700;
    border-radius: 10px;
    cursor: pointer;
    text-decoration: none;
    white-space: nowrap;
    border: 2px solid var(--yellow);
    transition: background 0.35s ease, color 0.35s ease, transform 0.3s cubic-bezier(0.34,1.56,0.64,1), box-shadow 0.3s ease;
  }
  .hero .btn svg { width: 16px; height: 16px; transition: transform 0.3s ease; }

  /* primary: orange -> white bg, orange text on hover */
  .hero .btn-primary { background: var(--yellow); color: #fff; }
  .hero .btn-primary:hover {
    background: #fff; color: var(--yellow);
    transform: translateY(-3px);
    box-shadow: 0 14px 28px rgba(242,100,30,0.32);
  }
  .hero .btn-primary:hover svg { transform: translate(3px,-3px); }

  /* secondary: white -> orange bg, white text on hover */
  .hero .btn-secondary { background: #fff; color: var(--yellow); }
  .hero .btn-secondary:hover {
    background: var(--yellow); color: #fff;
    transform: translateY(-3px);
    box-shadow: 0 14px 28px rgba(242,100,30,0.32);
  }
  .hero .btn-secondary:hover svg { transform: translate(3px,-3px); }

  .hero .btn:active { transform: translateY(-1px) scale(0.98); }

  /* ================= RIGHT (angled image panel) ================= */
  .hero .right {
    position: relative;
    height: 100%;
    min-height: 620px;
  }

  /* orange angled background wedge behind image */
  .hero .right::before {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--yellow);
    clip-path: polygon(28% 0, 100% 0, 100% 100%, 62% 100%);
    z-index: 0;
  }

  /* dotted decoration */
  .hero .dots {
    position: absolute;
    width: 90px; height: 90px;
    z-index: 1;
    background-image: radial-gradient(rgba(242,100,30,0.45) 1.6px, transparent 1.6px);
    background-size: 15px 15px;
  }
  .hero .dots.left-dots { left: -150px; top: 90px; opacity: 0.6; }
  .hero .dots.right-dots { right: 40px; bottom: 90px; }

  /* chat bubble outline decoration */
  .hero .chat-deco {
    position: absolute;
    left: -120px; top: 175px;
    width: 64px; height: 56px;
    border: 2px solid var(--line);
    border-radius: 12px;
    z-index: 1;
  }
  .hero .chat-deco::after {
    content: "";
    position: absolute;
    left: 14px; bottom: -10px;
    width: 16px; height: 16px;
    border-right: 2px solid var(--line);
    border-bottom: 2px solid var(--line);
    transform: rotate(35deg);
    background: var(--page-bg);
  }

  /* the angled image mask */
  .hero .img-mask {
    position: absolute;
    inset: 18px 70px 18px 0;
    clip-path: polygon(30% 0, 100% 0, 100% 72%, 72% 100%, 0 100%, 0 28%);
    border-radius: 6px;
    overflow: hidden;
    z-index: 2;
    background: #ddd;
  }
  .hero .img-mask .slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.1s ease;
  }
  .hero .img-mask .slide.active { opacity: 1; }
  .hero .img-mask .slide img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
    background: linear-gradient(135deg,#cfcfcf,#a8a8a8);
  }

  /* ---- floating stat badge (12+) ---- */
  .hero .badge-years {
    position: absolute;
    left: 8%; top: 18px;
    background: #fff;
    border-radius: 16px;
    padding: 18px 22px;
    box-shadow: 0 16px 40px rgba(0,0,0,0.16);
    z-index: 4;
    min-width: 150px;
  }
  .hero .badge-years .big { font-size: 34px; font-weight: 800; color: var(--yellow); line-height: 1; }
  .hero .badge-years .sub { font-size: 13px; font-weight: 600; color: var(--dark); margin-top: 8px; line-height: 1.3; }

  /* ---- floating ROI badge (circle) ---- */
  .hero .badge-roi {
    position: absolute;
    right: 90px; bottom: 60px;
    width: 132px; height: 132px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 16px 40px rgba(0,0,0,0.18);
    z-index: 4;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    border: 6px solid rgba(255,255,255,0.5);
  }
  .hero .badge-roi .ic {
    width: 38px; height: 38px;
    border-radius: 50%;
    background: #fff5ef;
    color: var(--yellow);
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 8px;
  }
  .hero .badge-roi .ic svg { width: 20px; height: 20px; }
  .hero .badge-roi strong { font-size: 15px; font-weight: 800; }
  .hero .badge-roi span { font-size: 11px; color: var(--muted); margin-top: 2px; }

  /* ================= LOGO STRIP ================= */
  .hero .strip {
    grid-column: 1 / -1;
    background: var(--strip-bg);
    display: flex;
    align-items: center;
    gap: 40px;
    padding: 22px 40px 22px 72px;
    overflow: hidden;
  }
  .hero .strip .trusted {
    flex-shrink: 0;
    max-width: 150px;
  }
  .hero .strip .trusted p { font-size: 14px; line-height: 1.35; color: var(--dark); font-weight: 600; }
  .hero .strip .trusted .swoosh { margin-top: 6px; color: var(--yellow); }
  .hero .strip .trusted .swoosh svg { width: 60px; height: 14px; }

  .hero .marquee-wrap {
    position: relative;
    flex: 1;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
            mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
  }
  .hero .marquee {
    display: flex;
    align-items: center;
    gap: 60px;
    width: max-content;
    will-change: transform;
  }
  .hero .logo {
    display: flex;
    align-items: center;
    gap: 9px;
    color: #2a2722;
    font-size: 20px;
    font-weight: 700;
    opacity: 0.78;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .hero .logo svg { width: 26px; height: 26px; }

  .hero .rating {
    flex-shrink: 0;
    text-align: right;
    padding-left: 20px;
    border-left: 1px solid #e0ddd8;
  }
  .hero .rating .stars { color: var(--yellow); font-size: 15px; letter-spacing: 1px; }
  .hero .rating .score { font-size: 18px; font-weight: 800; display: inline-block; margin-left: 4px; vertical-align: middle; }
  .hero .rating .src { font-size: 12px; color: var(--muted); margin-top: 2px; }

  /* ================= TABLET ================= */
  @media (max-width: 1024px) {
    .hero { grid-template-columns: 1fr; min-height: 0; }
    .hero .left { padding: 56px 32px 30px; text-align: left; }
    .hero .left p { max-width: 560px; }

    .hero .right { min-height: 440px; order: 2; }
    .hero .right::before { clip-path: polygon(0 14%, 100% 0, 100% 100%, 0 100%); }
    .hero .img-mask { inset: 24px 40px; clip-path: polygon(8% 0, 100% 6%, 100% 88%, 80% 100%, 0 100%, 0 12%); }
    .hero .badge-years { left: 24px; top: 6px; }
    .hero .badge-roi { right: 50px; bottom: 30px; width: 116px; height: 116px; }
    .hero .chat-deco, .hero .dots.left-dots { display: none; }

    .hero .strip { padding: 20px 32px; flex-wrap: wrap; }
  }

  /* ================= MOBILE ================= */
  @media (max-width: 760px) {
    .hero .left { padding: 44px 20px 26px; }
    .hero .left h1 { font-size: 40px; }
    .hero .actions { gap: 14px; }
    .hero .btn { flex: 1; justify-content: center; min-width: 140px; }

    .hero .right { min-height: 340px; }
    .hero .right::before { clip-path: polygon(0 10%, 100% 0, 100% 100%, 0 100%); }
    .hero .img-mask { inset: 16px 16px; clip-path: polygon(6% 0, 100% 4%, 100% 90%, 82% 100%, 0 100%, 0 10%); }
    .hero .badge-years { left: 14px; top: 2px; padding: 12px 16px; min-width: 0; }
    .hero .badge-years .big { font-size: 26px; }
    .hero .badge-years .sub { font-size: 11px; }
    .hero .badge-roi { right: 20px; bottom: 18px; width: 92px; height: 92px; border-width: 4px; }
    .hero .badge-roi strong { font-size: 12px; }
    .hero .badge-roi .ic { width: 30px; height: 30px; margin-bottom: 4px; }
    .hero .dots { display: none; }

    .hero .strip {
      gap: 18px;
      padding: 18px 16px;
      flex-direction: column;
      align-items: flex-start;
    }
    .hero .rating { border-left: none; padding-left: 0; text-align: left; }
    .hero .marquee-wrap { width: 100%; }
  }
</style>

<section class="hero">

  <!-- ================= LEFT ================= -->
  <div class="left">
    <div class="eyebrow anim-l"><span class="dot"></span><span>Data. Strategy. Growth.</span></div>
    <h1 class="anim-l">Smarter Marketing.<br>Stronger Growth.</h1>
    <p class="anim-l">We craft data-driven strategies and high-impact campaigns that connect brands with the right audience and drive measurable results.</p>
    <div class="actions anim-l">
      <a class="btn btn-primary" href="#">Get Free Audit
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
      </a>
      <a class="btn btn-secondary" href="#">View Our Portfolio
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
      </a>
    </div>
  </div>

  <!-- ================= RIGHT ================= -->
  <div class="right anim-r">
    <span class="dots left-dots"></span>
    <span class="dots right-dots"></span>
    <span class="chat-deco"></span>

    <!-- rotating images -->
    <div class="img-mask" id="slideshow">
      <div class="slide active"><img src="/optimized/hero-1.webp" alt="Digital Marketing Strategy 1"></div>
      <div class="slide"><img src="/optimized/hero-2.webp" alt="Digital Marketing Strategy 2"></div>
      <div class="slide"><img src="/optimized/hero-3.webp" alt="Digital Marketing Strategy 3"></div>
    </div>

    <!-- floating badges -->
    <div class="badge-years">
      <div class="big">12+</div>
      <div class="sub">Years of Driving<br>Digital Success</div>
    </div>

    <div class="badge-roi">
      <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="6" y1="18" x2="18" y2="6"/><polyline points="9 6 18 6 18 15"/></svg></div>
      <strong>ROI Focused</strong>
      <span>Results That Scale</span>
    </div>
  </div>

  <!-- ================= LOGO STRIP ================= -->
  <div class="strip">
    <div class="trusted">
      <p>Trusted by ambitious brands worldwide</p>
      <div class="swoosh"><svg viewBox="0 0 60 14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M2 9c10-7 24-7 34-2s18 4 22-1"/></svg></div>
    </div>

    <div class="marquee-wrap">
      <div class="marquee" id="heroMarquee">
        <!-- logos injected & duplicated by JS -->
      </div>
    </div>

    <div class="rating">
      <div><span class="stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span><span class="score">4.9/5</span></div>
      <div class="src">Clutch Reviews</div>
    </div>
  </div>

</section>
