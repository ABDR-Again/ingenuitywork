        Social Media Management
        <svg class="faq-arrow-icon" viewBox="0 0 24 24"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <button class="faq-cat-btn faq-gsap-btn" data-category="landing">
        <svg viewBox="0 0 24 24"><path d="M3 5a2 2 0 012-2h14a2 2 0 012 2v14a2 2 0 01-2 2H5a2 2 0 01-2-2V5zm2 0v2h14V5H5zm0 4v10h14V9H5z" fill="currentColor"/></svg>
        Landing Pages
        <svg class="faq-arrow-icon" viewBox="0 0 24 24"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <button class="faq-cat-btn faq-gsap-btn" data-category="custom">
        <svg viewBox="0 0 24 24"><path d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Custom Website
        <svg class="faq-arrow-icon" viewBox="0 0 24 24"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <button class="faq-cat-btn faq-gsap-btn" data-category="google">
        <svg viewBox="0 0 24 24"><path d="M12 2L2 22h20L12 2zm0 4.5l7 14H5l7-14z" fill="currentColor"/></svg>
        Google Ads
        <svg class="faq-arrow-icon" viewBox="0 0 24 24"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <button class="faq-cat-btn faq-gsap-btn" data-category="ghl">
        <svg viewBox="0 0 24 24"><path d="M12 3l7 7h-4v11h-6V10H5l7-7zm0 5v2H8v6h8v-6h-4V8z" fill="currentColor"/></svg>
        Go High Level
        <svg class="faq-arrow-icon" viewBox="0 0 24 24"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </aside>

    <div class="faq-content" id="faqContainer"></div>
  </div>
</section>
