<!-- ===================== WHY CHOOSE US SECTION ===================== -->
<style>
  .why-choose-us {
    --wcu-yellow: #FACC15;
    --wcu-yellow-soft: #FEF9C3;
    --wcu-dark: #17140f;
    --wcu-muted: #76726d;
    --wcu-card-shadow: 0 10px 34px rgba(0,0,0,0.07);
  }

  .why-choose-us .wcu-inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 80px 32px 100px;
  }

  .why-choose-us .wcu-head { text-align: center; margin-bottom: 70px; }
  .why-choose-us .wcu-head h2 {
    font-size: clamp(30px, 4.4vw, 52px);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.05;
    margin-bottom: 18px;
  }
  .why-choose-us .wcu-head h2 .accent { color: var(--wcu-yellow); }
  .why-choose-us .wcu-head p {
    font-size: clamp(15px, 1.5vw, 18px);
    color: var(--wcu-muted);
    font-weight: 500;
    max-width: 560px;
    margin: 0 auto;
    line-height: 1.55;
  }

  .why-choose-us .wcu-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: center;
    margin-bottom: 90px;
  }
  .why-choose-us .wcu-row:last-child { margin-bottom: 0; }
  .why-choose-us .wcu-row.reverse .wcu-media { order: 2; }
  .why-choose-us .wcu-row.reverse .wcu-points { order: 1; }

  .why-choose-us .wcu-media {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    aspect-ratio: 16 / 11;
    box-shadow: var(--wcu-card-shadow);
    background: #eceae7;
  }
  .why-choose-us .wcu-media img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
    background: #eceae7;
  }

  .why-choose-us .wcu-points {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .why-choose-us .wcu-point {
    display: flex;
    gap: 18px;
    align-items: flex-start;
    padding: 18px 20px;
    border-radius: 14px;
    cursor: default;
    transition: background 0.35s ease, transform 0.35s cubic-bezier(0.34,1.4,0.64,1), box-shadow 0.35s ease;
  }
  .why-choose-us .wcu-point .icon {
    flex-shrink: 0;
    width: 44px; height: 44px;
    border-radius: 11px;
    background: var(--wcu-yellow-soft);
    color: var(--wcu-yellow);
    display: flex; align-items: center; justify-content: center;
    transition: background 0.35s ease, color 0.35s ease, transform 0.35s cubic-bezier(0.34,1.56,0.64,1);
  }
  .why-choose-us .wcu-point .icon svg { width: 23px; height: 23px; }

  .why-choose-us .wcu-point .ptext h3 {
    font-size: 19px; font-weight: 700; line-height: 1.25; margin-bottom: 6px; transition: color 0.35s ease;
  }
  .why-choose-us .wcu-point .ptext h3 .num { color: var(--wcu-yellow); margin-right: 4px; transition: color 0.35s ease; }
  .why-choose-us .wcu-point .ptext p {
    font-size: 14.5px; color: var(--wcu-muted); line-height: 1.5; transition: color 0.35s ease;
  }

  .why-choose-us .wcu-point:hover {
    background: var(--wcu-yellow);
    transform: translateY(-4px);
    box-shadow: 0 16px 34px rgba(242,112,27,0.32);
  }
  .why-choose-us .wcu-point:hover .icon {
    background: rgba(255,255,255,0.22); color: #fff; transform: scale(1.08) rotate(-5deg);
  }
  .why-choose-us .wcu-point:hover .ptext h3,
  .why-choose-us .wcu-point:hover .ptext h3 .num { color: #fff; }
  .why-choose-us .wcu-point:hover .ptext p { color: rgba(255,255,255,0.9); }

  @media (max-width: 1024px) {
    .why-choose-us .wcu-inner { padding: 64px 26px 80px; }
    .why-choose-us .wcu-head { margin-bottom: 52px; }
    .why-choose-us .wcu-row { gap: 34px; margin-bottom: 64px; }
    .why-choose-us .wcu-media { aspect-ratio: 16 / 12; }
    .why-choose-us .wcu-point { padding: 14px 16px; gap: 14px; }
    .why-choose-us .wcu-point .ptext h3 { font-size: 17.5px; }
    .why-choose-us .wcu-point .ptext p { font-size: 14px; }
  }

  @media (max-width: 760px) {
    .why-choose-us .wcu-inner { padding: 48px 18px 64px; }
    .why-choose-us .wcu-head { margin-bottom: 34px; }
    .why-choose-us .wcu-row { display: block; margin-bottom: 12px; }
    .why-choose-us .wcu-media { display: none; }
    .why-choose-us .wcu-points { gap: 14px; margin-bottom: 26px; }
    .why-choose-us .wcu-point { padding: 16px 16px; }
    .why-choose-us .wcu-point .icon { width: 42px; height: 42px; }
    .why-choose-us .wcu-point .ptext h3 { font-size: 17px; }
    .why-choose-us .wcu-point .ptext p { font-size: 14px; }
  }
</style>

